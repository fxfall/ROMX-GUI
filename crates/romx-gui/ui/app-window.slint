import {
    Button,
    CheckBox,
    ComboBox,
    GroupBox,
    HorizontalBox,
    LineEdit,
    ListView,
    ScrollView,
    VerticalBox,
} from "std-widgets.slint";

export global RomxTheme {
    out property <color> canvas: #f4f6fb;
    out property <color> card: #ffffff;
    out property <color> card-muted: #f8f9fc;
    out property <color> border: #e4e7ec;
    out property <color> text: #182230;
    out property <color> text-muted: #667085;
    out property <color> text-subtle: #98a2b3;
    out property <color> accent: #4f46e5;
    out property <color> accent-soft: #eef2ff;
    out property <color> success-soft: #ecfdf3;
}

export component MainWindow inherits Window {
    title: "ROMX";
    no-frame: false;
    background: RomxTheme.canvas;
    // The work area is intentionally a three-column layout. Keep enough
    // room for the cover, source/list controls, and metadata form at the
    // default size while still allowing the window to be resized smaller.
    preferred-width: 1120px;
    preferred-height: 820px;
    min-width: 1000px;
    min-height: 600px;

    in-out property <int> active_page: 0;
    in-out property <int> pack_subpage: 0;
    // 0 = English, 1 = Simplified Chinese.
    in-out property <int> language_index: 0;
    in-out property <string> app_version;

    in-out property <string> rom_path;
    // When more than one source file is selected, these are the portable
    // payload paths stored in the ROMX RIDX.  The selected entry is written
    // first and becomes the launch descriptor.
    in-out property <[string]> payload_entries;
    in-out property <int> payload_entrypoint_index: -1;
    in-out property <string> cover_path;
    in-out property <string> metadata_path;
    in-out property <string> save_path;
    // Optional local save directory used to size the ROMX mutable region.
    in-out property <string> mutable_save_path;
    in-out property <string> romx_diagnostic;
    in-out property <image> cover_preview;
    in-out property <[string]> embedded_cover_options;
    in-out property <int> embedded_cover_index: -1;
    in-out property <image> match_cover_preview;
    in-out property <bool> match_cover_available: false;

    // Editable metadata mirrors the LPLX/ROMX metadata contract.
    in-out property <string> display_title;
    in-out property <string> genre;
    in-out property <string> platform: "gba";
    in-out property <string> developer;
    in-out property <string> release_date;
    in-out property <string> origin;
    in-out property <string> custom_crc;
    in-out property <string> custom_serial;
    in-out property <string> identity_mode;

    in-out property <int> resolution_index: 0;
    in-out property <string> custom_resolution: "512 × 512";
    // ROMX files produced by the GUI are consumed by libromx, which stores
    // SAVE/CHEAT/STATS objects in the mutable region.  Keep reservation on by
    // default; users can still opt out for intentionally compact containers.
    in-out property <bool> reserve_mutable: true;
    in-out property <bool> conflict_visible: false;
    in-out property <string> conflict_path;
    in-out property <bool> error_visible: false;
    in-out property <string> error_message;
    in-out property <bool> preflight_visible: false;
    // 0 = ask whether to scan, 1 = show scan results before conversion.
    in-out property <int> preflight_stage: 0;
    in-out property <bool> preflight_scanning: false;
    in-out property <string> preflight_report;
    in-out property <bool> conversion_running: false;
    in-out property <int> conversion_current: 0;
    in-out property <int> conversion_total: 0;
    in-out property <int> conversion_imported: 0;
    in-out property <int> conversion_skipped: 0;

    in-out property <bool> online_match_running: false;
    in-out property <bool> match_visible: false;
    in-out property <string> match_title;
    in-out property <string> match_message;
    in-out property <int> match_record_count: -1;
    in-out property <[string]> match_fields;
    in-out property <[bool]> match_field_selected;
    in-out property <length> match_window_x: 210px;
    in-out property <length> match_window_y: 80px;
    in-out property <length> match_drag_origin_x: 210px;
    in-out property <length> match_drag_origin_y: 80px;

    in-out property <string> unpack_input_path;
    in-out property <string> unpack_rom_dir;
    in-out property <string> unpack_cover_dir;
    in-out property <string> unpack_save_dir;
    in-out property <string> unpack_lpl_dir;
    in-out property <string> unpack_lpl_rom_path;
    in-out property <string> unpack_lpl_cover_path;
    in-out property <[string]> unpack_romx_files;
    in-out property <int> unpack_romx_selected: -1;
    in-out property <string> lpl_path;
    in-out property <string> lpl_work_path;
    in-out property <string> lpl_rom_dir;
    in-out property <string> lpl_image_dir;
    in-out property <string> lpl_save_path;
    in-out property <string> lpl_detail_title;
    in-out property <string> lpl_detail_format: "-";
    in-out property <string> lpl_detail_info;
    in-out property <[string]> lpl_rom_files;
    in-out property <[string]> lpl_output_files;
    in-out property <int> lpl_rom_selected: -1;
    in-out property <int> lpl_output_selected: -1;
    in-out property <string> lpl_selected_path;
    in-out property <int> lpl_selected_item_index: 0;
    in-out property <bool> editing_lpl_file: false;
    in-out property <string> status_text;

    pure callback translate(string, int) -> string;
    callback language_changed();
    callback platform_changed();
    callback embedded_cover_changed(index: int);
    callback payload_entrypoint_changed(index: int);

    changed language_index => {
        root.language_changed();
    }

    changed platform => {
        root.platform_changed();
    }

    changed embedded_cover_index => {
        if root.embedded_cover_index >= 0 {
            root.embedded_cover_changed(root.embedded_cover_index);
        }
    }

    changed payload_entrypoint_index => {
        if root.payload_entrypoint_index >= 0 {
            root.payload_entrypoint_changed(root.payload_entrypoint_index);
        }
    }

    callback open_rom_clicked();
    callback open_cover_clicked();
    callback open_metadata_clicked();
    callback open_save_path_clicked();
    callback open_mutable_save_path_clicked();
    callback online_match_clicked();
    callback match_field_toggled(index: int, checked: bool);
    callback match_select_all_clicked();
    callback match_write_clicked();
    callback match_write_all_clicked();
    callback match_cancel_clicked();
    callback open_lpl_clicked();
    callback open_lpl_rom_dir_clicked();
    callback open_lpl_image_dir_clicked();
    callback open_lpl_save_path_clicked();
    callback lpl_rom_file_clicked(index: int);
    callback lpl_output_file_clicked(index: int);
    callback edit_lpl_file_clicked();
    callback save_lpl_edit_clicked();
    callback return_lpl_edit_clicked();
    callback convert_clicked();
    callback preflight_scan_clicked();
    callback preflight_skip_clicked();
    callback preflight_start_clicked();
    callback preflight_cancel_clicked();
    callback cancel_conversion_clicked();
    callback conflict_skip_clicked();
    callback conflict_skip_all_clicked();
    callback conflict_rename_clicked();
    callback conflict_rename_all_clicked();
    callback conflict_replace_clicked();
    callback conflict_replace_all_clicked();
    callback error_continue_clicked();
    callback error_stop_clicked();
    callback open_unpack_file_clicked();
    callback open_unpack_folder_clicked();
    callback open_unpack_rom_dir_clicked();
    callback open_unpack_cover_dir_clicked();
    callback open_unpack_save_dir_clicked();
    callback open_unpack_lpl_dir_clicked();
    callback unpack_romx_file_clicked(index: int);
    callback unpack_file_convert_clicked();
    callback unpack_batch_convert_clicked();
    callback window_minimize_clicked();
    callback window_maximize_clicked();
    callback window_close_clicked();

    Rectangle {
        background: RomxTheme.canvas;
        width: parent.width;
        height: parent.height;
    }

    // The main navigation is horizontal so the work area can use the full
    // window width. The three navigation levels still update the same state
    // and callbacks as the original sidebar.
    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 78px;
        background: RomxTheme.card;
        border-color: RomxTheme.border;
        border-width: 1px;

        HorizontalBox {
            x: 18px;
            y: 8px;
            width: parent.width - 36px;
            height: 56px;
            spacing: 12px;

            HorizontalBox {
                width: 194px;
                height: 42px;
                spacing: 10px;
                Rectangle {
                    width: 38px;
                    height: 38px;
                    background: RomxTheme.accent;
                    border-radius: 11px;
                    Text {
                        text: "R";
                        color: #ffffff;
                        font-size: 21px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: parent.width;
                        height: parent.height;
                    }
                }
                VerticalBox {
                    spacing: 0px;
                    Text {
                        text: "ROMX";
                        color: RomxTheme.text;
                        font-size: 18px;
                        font-weight: 700;
                        height: 22px;
                    }
                    Text {
                        text: "v" + root.app_version + " · Container toolkit";
                        color: RomxTheme.text-muted;
                        font-size: 11px;
                        height: 18px;
                    }
                }
            }
            Text {
                text: root.translate("pack", root.language_index);
                color: RomxTheme.text-muted;
                font-size: 12px;
                font-weight: 600;
                width: 48px;
                wrap: word-wrap;
                vertical-alignment: center;
            }
            Button {
                text: root.translate("game_file", root.language_index);
                width: 110px;
                height: 34px;
                primary: root.active_page == 0 && root.pack_subpage == 0;
                clicked => {
                    root.active_page = 0;
                    root.pack_subpage = 0;
                }
            }
            Button {
                text: root.translate("lpl_file", root.language_index);
                width: 100px;
                height: 34px;
                primary: root.active_page == 0 && root.pack_subpage == 1;
                clicked => {
                    root.active_page = 0;
                    root.pack_subpage = 1;
                }
            }
            Rectangle {
                width: 1px;
                height: 28px;
                background: RomxTheme.border;
            }
            Text {
                text: root.translate("unpack", root.language_index);
                color: RomxTheme.text-muted;
                font-size: 12px;
                font-weight: 600;
                width: 70px;
                wrap: word-wrap;
                vertical-alignment: center;
            }
            Button {
                text: root.translate("romx_file_folder", root.language_index);
                width: 150px;
                height: 34px;
                primary: root.active_page == 1;
                clicked => {
                    root.active_page = 1;
                }
            }
            Rectangle { horizontal-stretch: 1; }
            ComboBox {
                model: [
                    root.translate("language_en", root.language_index),
                    root.translate("language_zh", root.language_index)
                ];
                current-index <=> root.language_index;
                width: 126px;
                height: 34px;
            }
        }
    }

    Rectangle {
        x: 14px;
        y: 94px;
        width: parent.width - 28px;
        height: parent.height - 166px;
        background: transparent;

        HorizontalBox {
            width: parent.width;
            height: parent.height;
            spacing: 14px;

            // Shared cover/artwork area. The source path controls remain in
            // the center panel; this column is for preview and image options.
            Rectangle {
                // Keep the cover column fixed so all pages share the same
                // center/right column geometry.
                horizontal-stretch: 0;
                preferred-width: 270px;
                min-width: 0px;
                height: parent.height;
                background: RomxTheme.card;
                border-color: RomxTheme.border;
                border-width: 1px;
                border-radius: 14px;
                drop-shadow-color: #172b4d12;
                drop-shadow-blur: 14px;
                drop-shadow-offset-y: 4px;
                clip: true;

                VerticalBox {
                    padding: 12px;
                    spacing: 8px;

                    Text {
                        text: root.translate("cover_preview", root.language_index);
                        color: RomxTheme.text;
                        font-size: 16px;
                        font-weight: 700;
                        wrap: word-wrap;
                        height: 24px;
                    }
                    Rectangle {
                        height: 230px;
                        background: RomxTheme.card-muted;
                        border-color: RomxTheme.border;
                        border-width: 1px;
                        border-radius: 11px;
                        Image {
                            source: root.cover_preview;
                            image-fit: contain;
                            x: 6px;
                            y: 6px;
                            width: parent.width - 12px;
                            height: parent.height - 12px;
                        }
                    }
                    if root.embedded_cover_options.length > 1: ComboBox {
                        model: root.embedded_cover_options;
                        current-index <=> root.embedded_cover_index;
                        height: 32px;
                    }
                    Text {
                        text: root.embedded_cover_options.length > 1
                            ? root.translate("embedded_cover_choice", root.language_index)
                            : "PNG / JPG / WebP / GIF / BMP";
                        color: RomxTheme.text-muted;
                        font-size: 11px;
                        wrap: word-wrap;
                        height: 28px;
                    }
                    if root.active_page == 0: GroupBox {
                        title: root.translate("cover_resolution", root.language_index);
                        height: 72px;
                        VerticalBox {
                            padding: 6px;
                            spacing: 5px;
                            if root.resolution_index != 5: ComboBox {
                                model: [
                                    root.translate("resolution_original", root.language_index),
                                    "256 × 224",
                                    "320 × 240",
                                    "512 × 512",
                                    "640 × 480",
                                    root.translate("resolution_custom", root.language_index)
                                ];
                                current-index <=> root.resolution_index;
                                height: 30px;
                            }
                            if root.resolution_index == 5: LineEdit {
                                text <=> root.custom_resolution;
                                placeholder-text: root.translate("resolution_custom", root.language_index);
                                height: 30px;
                            }
                        }
                    }
                    if root.active_page == 0: HorizontalBox {
                        height: 52px;
                        spacing: 6px;
                        CheckBox {
                            text: "";
                            checked <=> root.reserve_mutable;
                            width: 20px;
                            height: 24px;
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            Text {
                                text: root.translate("reserve_mutable", root.language_index);
                                color: RomxTheme.text-muted;
                                wrap: word-wrap;
                                vertical-alignment: center;
                                width: parent.width;
                                height: parent.height;
                            }
                            TouchArea {
                                clicked => { root.reserve_mutable = !root.reserve_mutable; }
                            }
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                    if root.display_title != "": Text {
                        text: root.display_title;
                        color: RomxTheme.text-muted;
                        wrap: word-wrap;
                        vertical-alignment: center;
                        height: 52px;
                    }
                }
            }

            // Single-file packing/editing page.
            if root.active_page == 0 && root.pack_subpage == 0: Rectangle {
                horizontal-stretch: 0;
                preferred-width: 384px;
                min-width: 0px;
                height: parent.height;
                background: RomxTheme.card;
                border-color: RomxTheme.border;
                border-width: 1px;
                border-radius: 14px;
                drop-shadow-color: #172b4d12;
                drop-shadow-blur: 14px;
                drop-shadow-offset-y: 4px;
                clip: true;

                VerticalBox {
                    padding: 14px;
                    spacing: 8px;
                    Text {
                        text: root.translate("files", root.language_index);
                        color: RomxTheme.text;
                        font-size: 18px;
                        font-weight: 700;
                        height: 26px;
                    }
                    if root.editing_lpl_file: Rectangle {
                        background: RomxTheme.accent-soft;
                        border-radius: 6px;
                        height: 48px;
                        HorizontalBox {
                            padding: 8px;
                            spacing: 8px;
                            Text {
                                text: root.translate("progress", root.language_index) + " "
                                    + root.conversion_current + "/" + root.conversion_total + "  "
                                    + root.translate("success", root.language_index) + " " + root.conversion_imported + "  "
                                    + root.translate("skipped", root.language_index) + " " + root.conversion_skipped;
                                color: RomxTheme.text-muted;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            Button {
                                text: root.translate("cancel", root.language_index);
                                width: 68px;
                                height: 30px;
                                enabled: root.conversion_running;
                                clicked => { root.cancel_conversion_clicked(); }
                            }
                        }
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalBox {
                            width: parent.width;
                            spacing: 12px;
                            if !root.editing_lpl_file: VerticalBox {
                                spacing: 2px;
                                Text { text: root.translate("game_path", root.language_index); color: RomxTheme.text-muted; height: 20px; }
                                HorizontalBox {
                                    spacing: 8px;
                                    height: 38px;
                                    LineEdit {
                                        text <=> root.rom_path;
                                        placeholder-text: root.translate("choose_rom_romx", root.language_index);
                                        horizontal-stretch: 1;
                                        height: 34px;
                                    }
                                    Button {
                                        text: root.translate("open", root.language_index);
                                        width: 72px;
                                        height: 34px;
                                        clicked => { root.open_rom_clicked(); }
                                    }
                                }
                                if root.payload_entries.length > 1: VerticalBox {
                                    spacing: 2px;
                                    Text {
                                        text: root.translate("payload_entrypoint", root.language_index);
                                        color: RomxTheme.text-muted;
                                        height: 20px;
                                    }
                                    ComboBox {
                                        model: root.payload_entries;
                                        current-index <=> root.payload_entrypoint_index;
                                        horizontal-stretch: 1;
                                        min-width: 0px;
                                        height: 32px;
                                    }
                                    Text {
                                        text: root.translate("payload_entry_hint", root.language_index);
                                        color: RomxTheme.text-subtle;
                                        wrap: word-wrap;
                                        height: 28px;
                                    }
                                }
                            }
                            VerticalBox {
                                spacing: 2px;
                                Text { text: root.translate("cover_image", root.language_index); color: RomxTheme.text-muted; height: 20px; }
                                HorizontalBox {
                                    spacing: 8px;
                                    height: 38px;
                                    LineEdit {
                                        text <=> root.cover_path;
                                        placeholder-text: root.translate("choose_cover_optional", root.language_index);
                                        horizontal-stretch: 1;
                                        height: 34px;
                                    }
                                    Button {
                                        text: root.translate("open", root.language_index);
                                        width: 72px;
                                        height: 34px;
                                        clicked => { root.open_cover_clicked(); }
                                    }
                                }
                            }
                            VerticalBox {
                                spacing: 2px;
                                Text { text: root.translate("metadata_json", root.language_index); color: RomxTheme.text-muted; height: 20px; }
                                HorizontalBox {
                                    spacing: 8px;
                                    height: 38px;
                                    LineEdit {
                                        text <=> root.metadata_path;
                                        placeholder-text: root.translate("choose_metadata_optional", root.language_index);
                                        horizontal-stretch: 1;
                                        height: 34px;
                                    }
                                    Button {
                                        text: root.translate("open", root.language_index);
                                        width: 72px;
                                        height: 34px;
                                        clicked => { root.open_metadata_clicked(); }
                                    }
                                }
                            }
                            VerticalBox {
                                spacing: 2px;
                                Text { text: root.translate("output_folder", root.language_index); color: RomxTheme.text-muted; height: 20px; }
                                HorizontalBox {
                                    spacing: 8px;
                                    height: 38px;
                                    LineEdit {
                                        text <=> root.save_path;
                                        placeholder-text: root.translate("choose_romx_output_folder", root.language_index);
                                        horizontal-stretch: 1;
                                        height: 34px;
                                    }
                                    Button {
                                        text: root.translate("open", root.language_index);
                                        width: 72px;
                                        height: 34px;
                                        clicked => { root.open_save_path_clicked(); }
                                    }
                                }
                            }
                            VerticalBox {
                                spacing: 2px;
                                Text { text: root.translate("save_folder", root.language_index); color: RomxTheme.text-muted; height: 20px; }
                                HorizontalBox {
                                    spacing: 8px;
                                    height: 38px;
                                    LineEdit {
                                        text <=> root.mutable_save_path;
                                        placeholder-text: root.translate("choose_save_folder_optional", root.language_index);
                                        horizontal-stretch: 1;
                                        height: 34px;
                                    }
                                    Button {
                                        text: root.translate("open", root.language_index);
                                        width: 72px;
                                        height: 34px;
                                        clicked => { root.open_mutable_save_path_clicked(); }
                                    }
                                }
                            }
                            if root.romx_diagnostic != "": Rectangle {
                                background: RomxTheme.card-muted;
                                border-radius: 6px;
                                height: 76px;
                                Text {
                                    text: root.romx_diagnostic;
                                    x: 8px;
                                    y: 6px;
                                    width: parent.width - 16px;
                                    height: parent.height - 12px;
                                    color: #475467;
                                    wrap: word-wrap;
                                    overflow: elide;
                                }
                            }
                            if root.editing_lpl_file: Text {
                                text: root.lpl_selected_path;
                                    color: RomxTheme.text-muted;
                                wrap: word-wrap;
                                height: 40px;
                            }
                        }
                    }
                }
            }

            // Metadata editing stays on the right, with a scrollable form.
            if root.active_page == 0 && root.pack_subpage == 0: Rectangle {
                preferred-width: 384px;
                horizontal-stretch: 0;
                min-width: 0px;
                height: parent.height;
                background: RomxTheme.card;
                border-color: RomxTheme.border;
                border-width: 1px;
                border-radius: 14px;
                drop-shadow-color: #172b4d12;
                drop-shadow-blur: 14px;
                drop-shadow-offset-y: 4px;
                clip: true;

                VerticalBox {
                    padding: 14px;
                    spacing: 8px;
                    Text {
                        text: root.translate("custom_game_metadata", root.language_index);
                        color: RomxTheme.text;
                        font-size: 18px;
                        font-weight: 700;
                        height: 28px;
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalBox {
                            width: parent.width;
                            spacing: 10px;
                            HorizontalBox {
                                spacing: 8px;
                                cross-axis-alignment: center;
                                min-width: 0px;
                                height: 34px;
                                Text { text: root.translate("display_title", root.language_index); width: 130px; horizontal-alignment: left; vertical-alignment: center; }
                                LineEdit { text <=> root.display_title; placeholder-text: root.translate("display_title_placeholder", root.language_index); horizontal-stretch: 1; min-width: 0px; height: 32px; }
                            }
                            HorizontalBox {
                                spacing: 8px;
                                cross-axis-alignment: center;
                                min-width: 0px;
                                height: 34px;
                                Text { text: root.translate("genre", root.language_index); width: 130px; horizontal-alignment: left; vertical-alignment: center; }
                                LineEdit { text <=> root.genre; placeholder-text: root.translate("genre_placeholder", root.language_index); horizontal-stretch: 1; min-width: 0px; height: 32px; }
                            }
                            HorizontalBox {
                                spacing: 8px;
                                cross-axis-alignment: center;
                                min-width: 0px;
                                height: 34px;
                                Text { text: root.translate("platform", root.language_index); width: 130px; horizontal-alignment: left; vertical-alignment: center; }
                                ComboBox {
                                    model: ["gb", "gbc", "gba", "nes", "snes", "n64", "nds", "3ds", "genesis", "mega_drive_32x", "sms", "gg", "pce", "pc_engine_cd", "sega_cd", "saturn", "dreamcast", "playstation", "ps2", "psp", "gamecube", "wii", "arcade", "scummvm", "dos", "amiga"];
                                    current-value <=> root.platform;
                                    horizontal-stretch: 1;
                                    min-width: 0px;
                                    height: 32px;
                                }
                            }
                            HorizontalBox {
                                spacing: 8px;
                                cross-axis-alignment: center;
                                min-width: 0px;
                                height: 34px;
                                Text { text: root.translate("developer", root.language_index); width: 130px; horizontal-alignment: left; vertical-alignment: center; }
                                LineEdit { text <=> root.developer; placeholder-text: root.translate("developer", root.language_index); horizontal-stretch: 1; min-width: 0px; height: 32px; }
                            }
                            HorizontalBox {
                                spacing: 8px;
                                cross-axis-alignment: center;
                                min-width: 0px;
                                height: 34px;
                                Text { text: root.translate("release_date", root.language_index); width: 130px; horizontal-alignment: left; vertical-alignment: center; }
                                LineEdit { text <=> root.release_date; placeholder-text: root.translate("release_date", root.language_index); horizontal-stretch: 1; min-width: 0px; height: 32px; }
                            }
                            HorizontalBox {
                                spacing: 8px;
                                cross-axis-alignment: center;
                                min-width: 0px;
                                height: 34px;
                                Text { text: root.translate("origin", root.language_index); width: 130px; horizontal-alignment: left; vertical-alignment: center; }
                                LineEdit { text <=> root.origin; placeholder-text: root.translate("origin_placeholder", root.language_index); horizontal-stretch: 1; min-width: 0px; height: 32px; }
                            }
                            HorizontalBox {
                                spacing: 8px;
                                cross-axis-alignment: center;
                                min-width: 0px;
                                height: 34px;
                                Text { text: root.translate("custom_crc", root.language_index); width: 130px; horizontal-alignment: left; vertical-alignment: center; }
                                LineEdit {
                                    text <=> root.custom_crc;
                                    placeholder-text: root.translate("custom_crc_placeholder", root.language_index);
                                    horizontal-stretch: 1;
                                    min-width: 0px;
                                    height: 32px;
                                    enabled: root.identity_mode == "crc32";
                                }
                            }
                            HorizontalBox {
                                spacing: 8px;
                                cross-axis-alignment: center;
                                min-width: 0px;
                                height: 34px;
                                Text { text: root.translate("custom_serial", root.language_index); width: 130px; horizontal-alignment: left; vertical-alignment: center; }
                                LineEdit {
                                    text <=> root.custom_serial;
                                    placeholder-text: root.translate("custom_serial_placeholder", root.language_index);
                                    horizontal-stretch: 1;
                                    min-width: 0px;
                                    height: 32px;
                                    enabled: root.identity_mode == "serial";
                                }
                            }
                        }
                    }
                    Button {
                        text: root.online_match_running
                            ? root.translate("online_matching", root.language_index)
                            : root.translate("online_match", root.language_index);
                        height: 34px;
                        enabled: !root.online_match_running;
                        clicked => { root.online_match_clicked(); }
                    }
                }
            }

            // LPL list page: keep the source controls in the center and place
            // the two folder previews in a dedicated right-hand column.
            if root.active_page == 0 && root.pack_subpage == 1: Rectangle {
                horizontal-stretch: 0;
                preferred-width: 384px;
                min-width: 0px;
                height: parent.height;
                background: RomxTheme.card;
                border-color: RomxTheme.border;
                border-width: 1px;
                border-radius: 14px;
                drop-shadow-color: #172b4d12;
                drop-shadow-blur: 14px;
                drop-shadow-offset-y: 4px;
                clip: true;

                VerticalBox {
                    padding: 14px;
                    spacing: 12px;
                    VerticalBox {
                        spacing: 2px;
                        Text { text: root.translate("lpl_file_path", root.language_index); color: RomxTheme.text-muted; height: 20px; }
                        HorizontalBox {
                            height: 38px;
                            spacing: 8px;
                            LineEdit { text <=> root.lpl_path; placeholder-text: root.translate("choose_lpl_file", root.language_index); horizontal-stretch: 1; height: 34px; }
                            Button { text: root.translate("open", root.language_index); width: 72px; height: 34px; clicked => { root.open_lpl_clicked(); } }
                        }
                    }
                    VerticalBox {
                        spacing: 2px;
                        Text { text: root.translate("rom_folder_path", root.language_index); color: RomxTheme.text-muted; height: 20px; }
                        HorizontalBox {
                            height: 38px;
                            spacing: 8px;
                            LineEdit { text <=> root.lpl_rom_dir; placeholder-text: root.translate("choose_rom_folder", root.language_index); horizontal-stretch: 1; height: 34px; }
                            Button { text: root.translate("open", root.language_index); width: 72px; height: 34px; clicked => { root.open_lpl_rom_dir_clicked(); } }
                        }
                    }
                    VerticalBox {
                        spacing: 2px;
                        Text { text: root.translate("image_folder", root.language_index); color: RomxTheme.text-muted; height: 20px; }
                        HorizontalBox {
                            height: 38px;
                            spacing: 8px;
                            LineEdit { text <=> root.lpl_image_dir; placeholder-text: root.translate("choose_image_folder", root.language_index); horizontal-stretch: 1; height: 34px; }
                            Button { text: root.translate("open", root.language_index); width: 72px; height: 34px; clicked => { root.open_lpl_image_dir_clicked(); } }
                        }
                    }
                    VerticalBox {
                        spacing: 2px;
                        Text { text: root.translate("output_folder", root.language_index); color: RomxTheme.text-muted; height: 20px; }
                        HorizontalBox {
                            height: 38px;
                            spacing: 8px;
                            LineEdit { text <=> root.lpl_save_path; placeholder-text: root.translate("choose_output_folder", root.language_index); horizontal-stretch: 1; height: 34px; }
                            Button { text: root.translate("open", root.language_index); width: 72px; height: 34px; clicked => { root.open_lpl_save_path_clicked(); } }
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                }
            }

            if root.active_page == 0 && root.pack_subpage == 1: Rectangle {
                preferred-width: 384px;
                horizontal-stretch: 0;
                min-width: 0px;
                height: parent.height;
                background: RomxTheme.card;
                border-color: RomxTheme.border;
                border-width: 1px;
                border-radius: 14px;
                drop-shadow-color: #172b4d12;
                drop-shadow-blur: 14px;
                drop-shadow-offset-y: 4px;
                clip: true;
                VerticalBox {
                    padding: 14px;
                    spacing: 8px;
                    Rectangle {
                        vertical-stretch: 1;
                        background: RomxTheme.card-muted;
                        border-radius: 6px;
                        VerticalBox {
                            padding: 8px;
                            Text { text: root.translate("rom_folder_preview", root.language_index); font-size: 16px; font-weight: 700; height: 24px; }
                            Rectangle {
                                vertical-stretch: 1;
                                background: #ffffff;
                                border-radius: 5px;
                                ListView {
                                    width: parent.width;
                                    height: parent.height;
                                    for item[index] in root.lpl_rom_files: Rectangle {
                                        width: parent.width;
                                        height: 28px;
                                        background: index == root.lpl_rom_selected ? RomxTheme.accent-soft : (Math.mod(index, 2) == 0 ? RomxTheme.card : RomxTheme.canvas);
                                        Text { x: 8px; text: item; color: RomxTheme.text-muted; vertical-alignment: center; width: parent.width - 16px; overflow: elide; }
                                        TouchArea { clicked => { root.lpl_rom_file_clicked(index); } }
                                    }
                                }
                                if root.lpl_rom_files.length == 0: Text {
                                    text: root.translate("no_rom_files", root.language_index);
                                    color: RomxTheme.text-subtle;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: parent.width;
                                    height: parent.height;
                                }
                            }
                        }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                        background: RomxTheme.card-muted;
                        border-radius: 6px;
                        VerticalBox {
                            padding: 8px;
                            Text { text: root.translate("output_folder_preview", root.language_index); font-size: 16px; font-weight: 700; height: 24px; }
                            Rectangle {
                                vertical-stretch: 1;
                                background: #ffffff;
                                border-radius: 5px;
                                ListView {
                                    width: parent.width;
                                    height: parent.height;
                                    for item[index] in root.lpl_output_files: Rectangle {
                                        width: parent.width;
                                        height: 28px;
                                        background: index == root.lpl_output_selected ? RomxTheme.accent-soft : (Math.mod(index, 2) == 0 ? RomxTheme.card : RomxTheme.canvas);
                                        Text { x: 8px; text: item; color: RomxTheme.text-muted; vertical-alignment: center; width: parent.width - 16px; overflow: elide; }
                                        TouchArea { clicked => { root.lpl_output_file_clicked(index); } }
                                    }
                                }
                                if root.lpl_output_files.length == 0: Text {
                                    text: root.translate("no_romx_output_files", root.language_index);
                                    color: RomxTheme.text-subtle;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: parent.width;
                                    height: parent.height;
                                }
                            }
                        }
                    }
                }
            }

            // Unpack page: keep the file controls/list compact and omit the
            // duplicate right-hand information preview.
            if root.active_page == 1: Rectangle {
                horizontal-stretch: 0;
                preferred-width: 384px;
                min-width: 0px;
                height: parent.height;
                background: RomxTheme.card;
                border-color: RomxTheme.border;
                border-width: 1px;
                border-radius: 14px;
                drop-shadow-color: #172b4d12;
                drop-shadow-blur: 14px;
                drop-shadow-offset-y: 4px;
                clip: true;

                VerticalBox {
                    padding: 14px;
                    spacing: 12px;
                    VerticalBox {
                        spacing: 2px;
                        Text { text: root.translate("input_file_folder", root.language_index); color: RomxTheme.text-muted; height: 20px; }
                        HorizontalBox {
                            height: 38px;
                            spacing: 8px;
                            LineEdit { text <=> root.unpack_input_path; placeholder-text: root.translate("choose_romx_file_folder", root.language_index); horizontal-stretch: 1; height: 34px; }
                            Button { text: root.translate("file", root.language_index); width: 64px; height: 34px; clicked => { root.open_unpack_file_clicked(); } }
                            Button { text: root.translate("folder", root.language_index); width: 72px; height: 34px; clicked => { root.open_unpack_folder_clicked(); } }
                        }
                    }
                    VerticalBox {
                        spacing: 2px;
                        Text { text: root.translate("rom_output_folder", root.language_index); color: RomxTheme.text-muted; height: 20px; }
                        HorizontalBox {
                            height: 38px;
                            spacing: 8px;
                            LineEdit { text <=> root.unpack_rom_dir; placeholder-text: root.translate("default_rom_output", root.language_index); horizontal-stretch: 1; height: 34px; }
                            Button { text: root.translate("open", root.language_index); width: 72px; height: 34px; clicked => { root.open_unpack_rom_dir_clicked(); } }
                        }
                    }
                    VerticalBox {
                        spacing: 2px;
                        Text { text: root.translate("cover_output_folder", root.language_index); color: RomxTheme.text-muted; height: 20px; }
                        HorizontalBox {
                            height: 38px;
                            spacing: 8px;
                            LineEdit { text <=> root.unpack_cover_dir; placeholder-text: root.translate("default_cover_output", root.language_index); horizontal-stretch: 1; height: 34px; }
                            Button { text: root.translate("open", root.language_index); width: 72px; height: 34px; clicked => { root.open_unpack_cover_dir_clicked(); } }
                        }
                    }
                    VerticalBox {
                        spacing: 2px;
                        Text { text: root.translate("save_output_folder", root.language_index); color: RomxTheme.text-muted; height: 20px; }
                        HorizontalBox {
                            height: 38px;
                            spacing: 8px;
                            LineEdit { text <=> root.unpack_save_dir; placeholder-text: root.translate("default_save_output", root.language_index); horizontal-stretch: 1; height: 34px; }
                            Button { text: root.translate("open", root.language_index); width: 72px; height: 34px; clicked => { root.open_unpack_save_dir_clicked(); } }
                        }
                    }
                    VerticalBox {
                        spacing: 2px;
                        Text { text: root.translate("lpl_content_root", root.language_index); color: RomxTheme.text-muted; height: 20px; }
                        HorizontalBox {
                            height: 38px;
                            spacing: 8px;
                            LineEdit { text <=> root.unpack_lpl_dir; placeholder-text: root.translate("choose_content_root", root.language_index); horizontal-stretch: 1; height: 34px; }
                            Button { text: root.translate("open", root.language_index); width: 72px; height: 34px; clicked => { root.open_unpack_lpl_dir_clicked(); } }
                        }
                    }
                    HorizontalBox {
                        vertical-stretch: 1;
                        spacing: 8px;
                        Rectangle {
                            horizontal-stretch: 1;
                            background: RomxTheme.card-muted;
                            border-radius: 6px;
                            VerticalBox {
                                padding: 8px;
                                Text { text: root.translate("romx_folder_preview", root.language_index); font-size: 16px; font-weight: 700; height: 24px; }
                                Rectangle {
                                    vertical-stretch: 1;
                                    background: #ffffff;
                                    border-radius: 5px;
                                    ListView {
                                        width: parent.width;
                                        height: parent.height;
                                        for item[index] in root.unpack_romx_files: Rectangle {
                                            width: parent.width;
                                            height: 28px;
                                            background: index == root.unpack_romx_selected ? RomxTheme.accent-soft : (Math.mod(index, 2) == 0 ? RomxTheme.card : RomxTheme.canvas);
                                            Text { x: 8px; text: item; color: RomxTheme.text-muted; vertical-alignment: center; width: parent.width - 16px; overflow: elide; }
                                            TouchArea { clicked => { root.unpack_romx_file_clicked(index); } }
                                        }
                                    }
                                    if root.unpack_romx_files.length == 0: Text {
                                        text: root.translate("no_romx_files", root.language_index);
                                        color: RomxTheme.text-subtle;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: parent.width;
                                        height: parent.height;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Keep the unpack page's custom LPL path controls, but remove only
            // the duplicate ROM/ROMX information preview above them.
            if root.active_page == 1: Rectangle {
                preferred-width: 384px;
                horizontal-stretch: 0;
                min-width: 0px;
                height: parent.height;
                background: RomxTheme.card;
                border-color: RomxTheme.border;
                border-width: 1px;
                border-radius: 14px;
                drop-shadow-color: #172b4d12;
                drop-shadow-blur: 14px;
                drop-shadow-offset-y: 4px;
                clip: true;
                VerticalBox {
                    padding: 14px;
                    spacing: 8px;
                    Text { text: root.translate("custom_lpl_paths", root.language_index); color: RomxTheme.text; font-size: 16px; font-weight: 700; height: 24px; }
                    Text { text: root.translate("rom_path", root.language_index); height: 18px; }
                    LineEdit { text <=> root.unpack_lpl_rom_path; placeholder-text: root.translate("default_lpl_rom_path", root.language_index); height: 32px; }
                    Text { text: root.translate("cover_path", root.language_index); height: 18px; }
                    LineEdit { text <=> root.unpack_lpl_cover_path; placeholder-text: root.translate("default_lpl_cover_path", root.language_index); height: 32px; }
                    Text { text: root.translate("custom_lpl_paths_hint", root.language_index); color: RomxTheme.text-muted; wrap: word-wrap; vertical-stretch: 1; }
                }
            }
        }
    }

    // The bottom action strip is shared by all three pages.
    Rectangle {
        x: 14px;
        y: parent.height - 62px;
        width: parent.width - 28px;
        height: 48px;
        background: RomxTheme.card;
        border-color: RomxTheme.border;
        border-width: 1px;
        border-radius: 14px;
        drop-shadow-color: #172b4d12;
        drop-shadow-blur: 12px;
        drop-shadow-offset-y: 3px;
        clip: true;
        HorizontalBox {
            x: 10px;
            y: 7px;
            width: parent.width - 20px;
            height: 34px;
            spacing: 8px;
            cross-axis-alignment: center;
            // Keep the status on the left while the action group remains in
            // the right-hand operation area of the shared action strip.
            Rectangle {
                horizontal-stretch: 1;
                preferred-width: 0px;
                min-width: 0px;
                height: 32px;
                Rectangle {
                    x: 2px;
                    y: 12px;
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: root.conversion_running ? #f79009 : #12b76a;
                }
                if root.conversion_running: Text {
                    text: root.translate("progress", root.language_index) + " "
                        + root.conversion_current + "/" + root.conversion_total + "  "
                        + root.translate("success", root.language_index) + " " + root.conversion_imported + "  "
                        + root.translate("skipped", root.language_index) + " " + root.conversion_skipped;
                    color: RomxTheme.text-muted;
                    vertical-alignment: center;
                    x: 16px;
                    width: parent.width - 16px;
                    height: parent.height;
                    overflow: elide;
                }
                if !root.conversion_running: Text {
                    text: root.status_text == ""
                        || root.status_text == root.translate("ready", 0)
                        || root.status_text == root.translate("ready", 1)
                        ? root.translate("ready", root.language_index)
                        : root.status_text;
                    color: RomxTheme.text-muted;
                    vertical-alignment: center;
                    x: 16px;
                    width: parent.width - 16px;
                    height: parent.height;
                    overflow: elide;
                }
            }
            HorizontalBox {
                spacing: 8px;
                height: 32px;
                cross-axis-alignment: center;
                if root.conversion_running: Button {
                    text: root.translate("cancel", root.language_index);
                    width: 74px;
                    height: 30px;
                    clicked => { root.cancel_conversion_clicked(); }
                }
                if !root.conversion_running && root.editing_lpl_file: Button {
                    text: root.translate("save", root.language_index);
                    width: 92px;
                    height: 30px;
                    clicked => { root.save_lpl_edit_clicked(); }
                }
                if !root.conversion_running && root.editing_lpl_file: Button {
                    text: root.translate("back", root.language_index);
                    width: 92px;
                    height: 30px;
                    clicked => { root.return_lpl_edit_clicked(); }
                }
                if !root.conversion_running && !root.editing_lpl_file && root.active_page == 0 && root.pack_subpage == 1 && root.lpl_selected_path != "": Button {
                    text: root.translate("edit_game_info", root.language_index);
                    width: 116px;
                    height: 30px;
                    clicked => { root.edit_lpl_file_clicked(); }
                }
                if !root.conversion_running && !root.editing_lpl_file && root.active_page == 0: Button {
                    text: root.translate("convert", root.language_index);
                    width: 104px;
                    height: 30px;
                    primary: true;
                    clicked => { root.convert_clicked(); }
                }
                if !root.conversion_running && root.active_page == 1: Button {
                    text: root.translate("file_convert", root.language_index);
                    width: 108px;
                    height: 30px;
                    primary: true;
                    clicked => { root.unpack_file_convert_clicked(); }
                }
                if !root.conversion_running && root.active_page == 1: Button {
                    text: root.translate("batch_convert", root.language_index);
                    width: 124px;
                    height: 30px;
                    clicked => { root.unpack_batch_convert_clicked(); }
                }
            }
        }
    }
    if root.match_visible: Rectangle {
        x: root.match_window_x;
        y: root.match_window_y;
        width: 760px;
        height: 540px;
        background: RomxTheme.card;
        border-radius: 16px;
        border-color: RomxTheme.border;
        border-width: 1px;
        drop-shadow-color: #172b4d26;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 10px;

        // A blank area of the result panel can be dragged to keep the
        // original ROM information visible behind it.
        TouchArea {
            width: parent.width;
            height: parent.height;
            pointer-event(event) => {
                if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                    root.match_drag_origin_x = root.match_window_x;
                    root.match_drag_origin_y = root.match_window_y;
                }
            }
            moved => {
                root.match_window_x = max(0px, root.match_drag_origin_x + self.mouse-x - self.pressed-x);
                root.match_window_y = max(0px, root.match_drag_origin_y + self.mouse-y - self.pressed-y);
            }
        }

        VerticalBox {
            padding: 18px;
            spacing: 10px;
            Rectangle {
                height: 42px;
                background: transparent;
                Text {
                    text: root.match_title;
                    font-size: 22px;
                    font-weight: 700;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }
            }
            Text {
                text: root.match_message;
                color: RomxTheme.text-muted;
                wrap: word-wrap;
                height: 34px;
            }
            HorizontalBox {
                vertical-stretch: 1;
                spacing: 12px;
                Rectangle {
                    width: 430px;
                    background: RomxTheme.card-muted;
                    border-radius: 10px;
                    if root.match_fields.length > 0: ListView {
                        x: 10px;
                        y: 10px;
                        width: parent.width - 20px;
                        height: parent.height - 20px;
                        for field[index] in root.match_fields: CheckBox {
                            text: field;
                            width: parent.width - 8px;
                            height: 38px;
                            checked: root.match_field_selected[index];
                            toggled => {
                                root.match_field_toggled(index, !root.match_field_selected[index]);
                            }
                        }
                    }
                    if root.match_fields.length == 0: Text {
                        text: root.translate("no_online_match", root.language_index);
                        color: RomxTheme.text-muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: parent.width;
                        height: parent.height;
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                    background: RomxTheme.card-muted;
                    border-radius: 10px;
                    Image {
                        source: root.match_cover_preview;
                        image-fit: contain;
                        x: 10px;
                        y: 10px;
                        width: parent.width - 20px;
                        height: parent.height - 20px;
                    }
                    if !root.match_cover_available: Text {
                        text: root.translate("online_cover_not_found", root.language_index);
                        color: RomxTheme.text-muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: parent.width;
                        height: parent.height;
                    }
                }
            }
            HorizontalBox {
                height: 44px;
                spacing: 12px;
                Button {
                    text: root.translate("select_all", root.language_index);
                    horizontal-stretch: 1;
                    height: 38px;
                    enabled: root.match_fields.length > 0;
                    clicked => { root.match_select_all_clicked(); }
                }
                Button {
                    text: root.translate("write_selected", root.language_index);
                    horizontal-stretch: 1;
                    height: 38px;
                    enabled: root.match_fields.length > 0;
                    primary: true;
                    clicked => { root.match_write_clicked(); }
                }
                Button {
                    text: root.translate("write_all", root.language_index);
                    horizontal-stretch: 1;
                    height: 38px;
                    enabled: root.match_fields.length > 0;
                    clicked => { root.match_write_all_clicked(); }
                }
                Button {
                    text: root.translate("cancel", root.language_index);
                    horizontal-stretch: 1;
                    height: 38px;
                    clicked => { root.match_cancel_clicked(); }
                }
            }
        }
    }

    if root.preflight_visible: Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: #18223066;
        Rectangle {
            x: (parent.width - 620px) / 2;
            y: (parent.height - 430px) / 2;
            width: 620px;
            height: 430px;
            background: RomxTheme.card;
            border-radius: 16px;
            drop-shadow-color: #172b4d26;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 10px;
            VerticalBox {
                padding: 18px;
                spacing: 10px;
                Text {
                    text: root.preflight_stage == 0
                        ? root.translate("preflight_scan", root.language_index)
                        : root.translate("scan_results", root.language_index);
                    font-size: 18px;
                    font-weight: 700;
                    height: 28px;
                }
                Rectangle {
                    vertical-stretch: 1;
                    background: RomxTheme.card-muted;
                    border-radius: 10px;
                    if root.preflight_stage == 0: Text {
                        text: root.preflight_scanning
                            ? root.translate("scanning_entries", root.language_index)
                            : root.translate("scan_prompt", root.language_index);
                        x: 12px;
                        y: 10px;
                        width: parent.width - 24px;
                        height: parent.height - 20px;
                        wrap: word-wrap;
                        color: RomxTheme.text-muted;
                    }
                    if root.preflight_stage == 1: Text {
                        text: root.preflight_report;
                        x: 12px;
                        y: 10px;
                        width: parent.width - 24px;
                        height: parent.height - 20px;
                        wrap: word-wrap;
                        overflow: elide;
                        color: RomxTheme.text-muted;
                    }
                }
                HorizontalBox {
                    height: 34px;
                    spacing: 8px;
                    Button {
                        text: root.translate("cancel", root.language_index);
                        width: 100px;
                        height: 30px;
                        clicked => { root.preflight_cancel_clicked(); }
                    }
                    if root.preflight_stage == 0: Button {
                        text: root.translate("skip_and_convert", root.language_index);
                        width: 140px;
                        height: 30px;
                        enabled: !root.conversion_running && !root.preflight_scanning;
                        clicked => { root.preflight_skip_clicked(); }
                    }
                    if root.preflight_stage == 0: Button {
                        text: root.translate("scan", root.language_index);
                        width: 120px;
                        height: 30px;
                        enabled: !root.conversion_running && !root.preflight_scanning;
                        clicked => { root.preflight_scan_clicked(); }
                    }
                    if root.preflight_stage == 1: Button {
                        text: root.translate("start", root.language_index);
                        width: 120px;
                        height: 30px;
                        enabled: !root.conversion_running && !root.preflight_scanning;
                        clicked => { root.preflight_start_clicked(); }
                    }
                }
            }
        }
    }

    if root.conflict_visible: Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: #18223066;
        Rectangle {
            x: (parent.width - 620px) / 2;
            y: (parent.height - 220px) / 2;
            width: 620px;
            height: 220px;
            background: RomxTheme.card;
            border-radius: 16px;
            drop-shadow-color: #172b4d26;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 10px;
            VerticalBox {
                padding: 18px;
                spacing: 10px;
                Text {
                    text: root.translate("output_exists", root.language_index);
                    font-size: 18px;
                    font-weight: 700;
                    height: 28px;
                }
                Text {
                    text: root.conflict_path;
                    color: RomxTheme.text-muted;
                    overflow: elide;
                    height: 24px;
                }
                HorizontalBox {
                    height: 34px;
                    spacing: 6px;
                    Button { text: root.translate("skip", root.language_index); width: 82px; height: 30px; clicked => { root.conflict_skip_clicked(); } }
                    Button { text: root.translate("skip_all", root.language_index); width: 92px; height: 30px; clicked => { root.conflict_skip_all_clicked(); } }
                    Button { text: root.translate("rename", root.language_index); width: 82px; height: 30px; clicked => { root.conflict_rename_clicked(); } }
                    Button { text: root.translate("rename_all", root.language_index); width: 104px; height: 30px; clicked => { root.conflict_rename_all_clicked(); } }
                    Button { text: root.translate("replace", root.language_index); width: 82px; height: 30px; clicked => { root.conflict_replace_clicked(); } }
                    Button { text: root.translate("replace_all", root.language_index); width: 104px; height: 30px; clicked => { root.conflict_replace_all_clicked(); } }
                }
            }
        }
    }

    if root.error_visible: Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: #18223066;
        Rectangle {
            x: (parent.width - 500px) / 2;
            y: (parent.height - 220px) / 2;
            width: 500px;
            height: 220px;
            background: RomxTheme.card;
            border-radius: 16px;
            drop-shadow-color: #172b4d26;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 10px;
            VerticalBox {
                padding: 18px;
                spacing: 10px;
                Text { text: root.translate("conversion_error", root.language_index); font-size: 18px; font-weight: 700; height: 28px; }
                Text { text: root.error_message; color: #b42318; wrap: word-wrap; vertical-stretch: 1; }
                HorizontalBox {
                    height: 34px;
                    spacing: 8px;
                    Button { text: root.translate("skip_continue", root.language_index); width: 130px; height: 30px; clicked => { root.error_continue_clicked(); } }
                    Button { text: root.translate("stop", root.language_index); width: 90px; height: 30px; clicked => { root.error_stop_clicked(); } }
                }
            }
        }
    }

}
